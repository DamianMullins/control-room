# PostHog personal API key (Query Read). Create at: PostHog → user settings → personal API keys
POSTHOG_PERSONAL_API_KEY=phx_...

# Projects to merge: key:label:project_id, comma separated.
# The key is the property name in the merged rows, the label is what the UI shows.
POSTHOG_PROJECTS=web:Web:12345,app:App:67890

# Sentry projects to merge: key:label:org:project:region, comma separated.
# region is "de" (de.sentry.io) or "us" (sentry.io) — projects in different orgs or
# regions are supported, they just need their own token below.
SENTRY_PROJECTS=web:Web:your-org:your-project:de,app:App:other-org:other-project:us

# Shared token, used for any project without a SENTRY_TOKEN_<KEY> of its own.
# Needs event:read + org:read; add project:read or that org's issues API answers 403
# (volumes still work, titles come from discover, statuses read "unknown").
SENTRY_AUTH_TOKEN=sntryu_...

# Optional per-org token, named after the project key in upper case.
# SENTRY_TOKEN_WEB=sntryu_...
# SENTRY_TOKEN_APP=sntryu_...

# Legacy single-project setup — only read when SENTRY_PROJECTS is unset.
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_BASE_URL=https://de.sentry.io/api/0
