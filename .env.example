# PostHog personal API key (Query Read). Create at: PostHog → user settings → personal API keys
POSTHOG_PERSONAL_API_KEY=phx_...

# Projects to merge: key:label:project_id, comma separated.
# The key is the property name in the merged rows, the label is what the UI shows.
POSTHOG_PROJECTS=web:Web:12345,app:App:67890

# Sentry user token with event:read + org:read
SENTRY_AUTH_TOKEN=sntryu_...

# Sentry org and project slug, plus the regional API base
# (https://de.sentry.io/api/0 for EU/DE, https://sentry.io/api/0 for US)
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_BASE_URL=https://de.sentry.io/api/0
